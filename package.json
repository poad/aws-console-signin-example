  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r --parallel --if-present lint",
    "lint-fix": "pnpm -r --parallel --if-present lint-fix",
    "prebuild": "pnpm -r install"
  },
  "devDependencies": {
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0"
  },
  "devEngines": {
